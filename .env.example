# ---------------------------------------------------------------- Server
PORT=3000
NODE_ENV=development

# -------------------------------------------------------------- Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/artisans

# -------------------------------------------------------------- Security
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 32 caractères minimum, sinon le serveur refuse de démarrer.
SESSION_SECRET=remplacez-moi

# Secure en production (HTTPS). Ne passer à false qu'en local sans HTTPS.
# COOKIE_SECURE=true

# --------------------------------------------------------- Rate limiting
# memory = compteur local, ineffective en déploiement multi-instance.
# Laisser vide pour utiliser PostgreSQL (recommandé).
# RATE_LIMIT_STORE=memory

# ------------------------------------------------------- Stockage fichiers
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=5242880

# Cloudinary - obligatoire en production sur Vercel, où le système de
# fichiers est en lecture seule. Renseigner les deux clés pour basculer.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ------------------------------------------------------ Signalements
# Nombre de signalements déclenchant le blocage / la suspension automatique.
# AUTO_BLOCK_REPORTS_THRESHOLD=3
# AUTO_SUSPEND_REPORTS_THRESHOLD=5

# ------------------------------------------------------------- SEO
# Domaine public, sans slash final : active rel="canonical", og:url et
# l'image de partage en URL absolue. Sans cette variable, ces balises sont
# omises plutôt que devinées - un canonical erroné est pire qu'un absent.
# SITE_URL=https://votre-domaine.com

# ------------------------------------------------------------ Mock
# Mode démonstration. Actif par défaut : le projet se manipule sans base de
# données ni backend. Le mettre à false pour travailler sur la vraie API —
# le sélecteur de rôle et le repli automatique sur les mocks sont alors
# désactivés, y compris en production.
# VITE_USE_MOCKS=false

# Service de personnes factices, utilisé une fois pour générer
# src/shared/mocks/personas.json (noms, villes, téléphones, portraits).
# L'URL n'est jamais appelée à l'exécution : le catalogue est figé dans le
# dépôt pour rester déterministe et ne pas exposer les visiteurs à un tiers.
# PERSONA_API_URL=https://persona-dev.onrender.com/people
# PERSONA_API_COUNT=48

# Tenue des portraits. `construction` force casque et bleu de travail ;
# `standard` ou `business` produiraient des tenues de bureau.
# PERSONA_PORTRAIT_CONTEXTS=construction

# Bornes d'âge d'un professionnel en activité.
# PERSONA_MIN_AGE=19
# PERSONA_MAX_AGE=69

# ------------------------------------------------------------ Admin Seed
ADMIN_PHONE=0600000001
ADMIN_PASSWORD=changez-moi-123