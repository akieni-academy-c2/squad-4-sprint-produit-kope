# ---------------------------------------------------------------- Server
PORT=3000
NODE_ENV=development

# -------------------------------------------------------------- Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/artisans

# -------------------------------------------------------------- Security
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 32 caractères minimum, sinon le serveur refuse de démarrer.
SESSION_SECRET=remplacez-moi

# Par défaut, le cookie de session suit le protocole réel de la requête :
# marqué `Secure` sur une connexion HTTPS, envoyé tel quel sur du HTTP simple.
# C'est ce qui permet à `bun start` en local de rester utilisable, tout en
# gardant un déploiement HTTPS protégé. Il n'est donc PAS déduit de NODE_ENV.
#
# Forcer une valeur n'est nécessaire que pour un déploiement réellement en
# HTTPS derrière un proxy qui ne transmettrait pas X-Forwarded-Proto :
# COOKIE_SECURE=true

# --------------------------------------------------------- Cache serveur
# Durée de vie du cache mémoire des listes de référence (métiers, quartiers,
# villes), relues à chaque page servie. Toute écriture d'un administrateur vide
# le cache immédiatement : ce délai n'est donc qu'une garde-fou.
# REFERENCE_CACHE_TTL_MS=300000

# --------------------------------------------------------- Rate limiting
# memory = compteur local, ineffective en déploiement multi-instance.
# Laisser vide pour utiliser PostgreSQL (recommandé).
# RATE_LIMIT_STORE=memory

# ------------------------------------------------------- Stockage fichiers
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=5242880

# Cloudinary - obligatoire en production sur Vercel, où le système de
# fichiers est en lecture seule. Renseigner les deux clés pour basculer.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ------------------------------------------------------ Signalements
# Nombre de signalements déclenchant le blocage / la suspension automatique.
# AUTO_BLOCK_REPORTS_THRESHOLD=3
# AUTO_SUSPEND_REPORTS_THRESHOLD=5

# ------------------------------------------------------------- SEO
# Domaine public, sans slash final : active rel="canonical", og:url et
# l'image de partage en URL absolue. Sans cette variable, ces balises sont
# omises plutôt que devinées - un canonical erroné est pire qu'un absent.
# SITE_URL=https://votre-domaine.com

# ------------------------------------------------------------ Mock
# Mode démonstration. La variable NE L'ACTIVE JAMAIS : elle décide seulement de
# son accessibilité. Le site démarre donc toujours sur la vraie API, et une panne
# de production reste visible au lieu de se déguiser en données fictives.
#
#   absente (défaut) : démo accessible
#   VITE_USE_MOCKS=true  : démo accessible
#   VITE_USE_MOCKS=false : démo VERROUILLÉE
#
# `false` est un verrou, pas un simple masquage : le sélecteur disparaît et
# `?demo=1` devient sans effet. Personne ne peut alors atteindre la démo.
#
# Le visiteur entre en démo quand il le décide, via le sélecteur de rôle ou l'URL
# `?demo=1` (`?demo=0` pour revenir à la vraie API). Son choix est mémorisé.
#
# Aucune erreur réseau ni 5xx ne déclenche de repli automatique, en
# développement comme en production : une panne, ou une migration non appliquée,
# doit rester visible plutôt que de se déguiser en données fictives. Ce repli
# existait en développement et masquait les pannes réelles - l'écran affichait
# des données de démonstration pendant que le serveur refusait la session.
#
# VITE_USE_MOCKS est lue au BUILD : sur Vercel, la variable doit être posée
# dans les variables d'environnement du projet PUIS le site redéployé, sinon
# le bundle déjà déployé ne change pas.
# VITE_USE_MOCKS=false

# Service de personnes factices, utilisé une fois pour générer
# src/shared/mocks/personas.json (noms, villes, téléphones, portraits).
# L'URL n'est jamais appelée à l'exécution : le catalogue est figé dans le
# dépôt pour rester déterministe et ne pas exposer les visiteurs à un tiers.
# Les portraits qu'elle renvoie sont rapatriés dans public/portraits/.
# PERSONA_API_URL=https://persona-dev.onrender.com/people
# PERSONA_API_COUNT=48

# Tenue des portraits. `construction` force casque et bleu de travail ;
# `standard` ou `business` produiraient des tenues de bureau.
# PERSONA_PORTRAIT_CONTEXTS=construction

# Bornes d'âge d'un professionnel en activité.
# PERSONA_MIN_AGE=19
# PERSONA_MAX_AGE=69

# ------------------------------------------------------------ Admin Seed
ADMIN_PHONE=0600000001
ADMIN_PASSWORD=changez-moi-123