{
  "name": "test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch server server/index.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:db": "vitest run tests/sql-live.test.js",
    "check": "npm run lint && npm run test:run",
    "icons": "node scripts/generate-icons.mjs",
    "prepare": "husky",
    "migrate": "node-pg-migrate -m server/db/migrations",
    "migrate:up": "node-pg-migrate up -m server/db/migrations",
    "migrate:down": "node-pg-migrate down -m server/db/migrations",
    "migrate:create": "node-pg-migrate create -m server/db/migrations --migration-file-language sql",
    "schema:doc": "node scripts/describe-schema.mjs",
    "docs:pdf": "node scripts/build-data-dictionary-pdf.mjs",
    "seed:admin": "node server/db/seeds/admin.js",
    "seed:clients": "node server/db/seeds/clients.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "lucide-react": "^1.51.0",
    "motion": "^14.1.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "vite-express": "^0.22.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --fix"
  }
}
